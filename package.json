{
  "name": "privacyguard",
  "version": "1.0.0",
  "description": "Centralized privacy dashboard for tracking and blocking online trackers",
  "private": true,
  "scripts": {
    "setup": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server",
    "prisma:seed": "npm run prisma:seed --prefix server"
  },
  "keywords": [
    "privacy",
    "tracker",
    "security",
    "dashboard",
    "browser-extension"
  ],
  "author": "PrivacyGuard Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/syedsadique-git/PrivacyGuard.git"
  },
  "devDependencies": {
    "prisma": "^5.11.0"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0"
  }
}
